{
  "name": "skysense-selenium-tests",
  "version": "1.0.0",
  "description": "End-to-End Selenium WebDriver tests for SkySense AI web frontend",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/**/*.js --timeout 30000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=test-report",
    "test:login": "mocha tests/login-tests.js --timeout 30000",
    "test:headed": "HEADLESS=false mocha tests/**/*.js --timeout 30000"
  },
  "dependencies": {
    "selenium-webdriver": "^4.18.1",
    "chromedriver": "^123.0.0",
    "geckodriver": "^4.3.3"
  },
  "devDependencies": {
    "mocha": "^10.4.0",
    "chai": "^5.1.1",
    "mochawesome": "^7.1.3",
    "dotenv": "^16.4.5"
  },
  "keywords": ["selenium", "e2e", "testing", "skysense", "webdriver"],
  "author": "SkySense QA Team",
  "license": "MIT"
}
