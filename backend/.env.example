# SkySense AI - Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
SECRET_KEY=skysense_super_secret_jwt_key_2026_change_in_production
ENVIRONMENT=development

# Database (MongoDB Atlas) - Optional fallback memory store active if empty
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/skysense?retryWrites=true&w=majority
DATABASE_NAME=skysense

# AI (Groq API) - Optional fallback AI intelligence active if empty
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloudinary Storage - Optional fallback avatar simulation if empty
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Auth (Service Account Path or JSON) - Optional fallback JWT mode active if empty
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
